# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000

# Local Postgres (already running via `brew services` on this machine).
# Note: port 5433, not the default 5432 — this machine also has a
# separate, password-protected PostgreSQL 17 install bound to 5432
# (/Library/PostgreSQL/17). createdb -p 5433 scorchepay first.
DATABASE_URL=postgres://mac@localhost:5433/scorchepay

# Get a free TEST secret key from https://dashboard.paystack.com/#/settings/developer
# (no business verification needed for test mode). Starts with sk_test_...
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Same dashboard — used client-side by the Flutter app to open the Paystack
# checkout. Starts with pk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed once you point Paystack's webhook settings at a public URL
# (e.g. an ngrok tunnel while testing, or your real deploy once hosted).
WEBHOOK_PATH=/api/webhooks/paystack

# Signs access/refresh JWTs. Generate your own with `openssl rand -hex 48`
# — never reuse the example below or commit your real one.
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — without a real key, OTP codes are logged to the server
# console instead of texted, so auth still works end-to-end in dev.
# Free key at https://accounts.termii.com/#/register
TERMII_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TERMII_SENDER_ID=ScorchePay

# Bills — free sandbox account at https://vtpass.com/#/register.
VTPASS_EMAIL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VTPASS_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VTPASS_ENV=sandbox

# Multi-currency conversion — business account at https://eversend.co.
EVERSEND_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EVERSEND_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Crypto→fiat conversion — https://quidax.io.
QUIDAX_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Exact browser origins allowed to call the live API (comma separated).
CORS_ORIGIN=http://localhost:54823
# Financial provider routes remain unavailable until their release gates pass.
# Run versioned migrations before this server version handles traffic.
